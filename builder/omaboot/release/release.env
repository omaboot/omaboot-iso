# What a release tag of this repo builds (builder/omaboot/release/build.sh). Change it in the commit
# the tag points at; everything else a release uses is pinned in pins/$OMABOOT_RELEASE/.

# The Omarchy release the image is pinned to (pins/<version>/)
OMABOOT_RELEASE=4.0.6
# The image type (only live is released for now)
OMABOOT_FLAVOUR=live
# The tester: built from this tag of the boot-live repo
BOOT_LIVE_REPO=https://github.com/omaboot/boot-live.git
BOOT_LIVE_TAG=v0.6.3-dev
# The Go toolchain image boot-live is built in (exact digest)
BOOT_LIVE_GO_IMAGE=golang:1.27.2-bookworm@sha256:5cf287a799e6b94384bad13d16b14904c531f51ba65792237e122ce42b392f61
