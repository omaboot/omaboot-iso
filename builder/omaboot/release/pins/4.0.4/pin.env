# OmaBoot? release pin for Omarchy 4.0.4 (made by omaboot_release.py pin; see ../../README.md)
OMARCHY_VERSION=4.0.4
# The official ISO: where it is, its checksum (from https://iso.omarchy.org/omarchy-4.0.4.iso.sha256) and the omarchy-iso commit it was built from
OFFICIAL_ISO_URL=https://iso.omarchy.org/omarchy-4.0.4.iso
OFFICIAL_ISO_SHA256=ddeded2758c48318d201dfdac905ecb28f570441883f0c052ea3cd5d05acf92d
OFFICIAL_ISO_DATE=2026.09.15
OFFICIAL_ISO_COMMIT=7cfb7111a06873d61c45d37034577d4ba08d3f4f
# Arch packages: the Arch Linux Archive day that holds every one the official ISO has, same checksums
# (229 core, 928 extra, 47 multilib)
ARCH_ARCHIVE_DATE=2026/09/07
# Omarchy (39) and t2linux arch-mact2 (5) packages: neither repo keeps a dated archive, so
# they come from the official ISO itself (official-packages.tsv, checked by sha256)
# apple-bcm-firmware: no repo serves it any more; classified by hand as arch-mact2
PINNED_REPOS="omarchy arch-mact2"
# The build container: the Arch image and archive day of the official ISO's build day (archiso, grub, ...)
BUILD_IMAGE=archlinux/archlinux:base-20260915.0.594185@sha256:d5eece8a54625240d98d9d5e3595f53137b2329d87016d3182a4a11b86dee77a
BUILD_ARCHIVE_DATE=2026/09/15
# Node.js tarball the official ISO carries for offline mise installs
NODE_VERSION=v26.8.2
