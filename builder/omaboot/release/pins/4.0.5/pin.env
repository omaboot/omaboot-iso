# OmaBoot? release pin for Omarchy 4.0.5 (made by omaboot_release.py pin; see ../../README.md)
OMARCHY_VERSION=4.0.5
# The official ISO: where it is, its checksum (from https://iso.omarchy.org/omarchy-4.0.5.iso.sha256) and the omarchy-iso commit it was built from
OFFICIAL_ISO_URL=https://iso.omarchy.org/omarchy-4.0.5.iso
OFFICIAL_ISO_SHA256=73fd4334f1f67b19cd8a5589f9363173fc3aec07c0a59f198833eaddb66877a1
OFFICIAL_ISO_DATE=2026.10.18
OFFICIAL_ISO_COMMIT=3872d5a3695258944084f975749b4f88b7eced4a
# Arch packages: the Arch Linux Archive day that holds the most of the official ISO's (every one but
# any in [arch-held] below), same checksums
# (230 core, 927 extra, 47 multilib)
ARCH_ARCHIVE_DATE=2026/10/18
# Omarchy (47) and t2linux arch-mact2 (5) packages: neither repo keeps a dated archive, so
# they come from the official ISO itself (official-packages.tsv, checked by sha256)
# Arch packages (4) the archive day above has newer builds of: Arch replaced them
# after the official ISO's package snapshot, so they come from the ISO too, in [arch-held]
# (ahead of core/extra/multilib), each the same file as on the archive day named
# avahi 1:0.9rc5-1: as on 2026/10/17
# libcolord 1.4.8-1: as on 2026/10/17
# libnotify 0.8.8-1: as on 2026/10/17
# nmap 7.991-1: as on 2026/10/17
PINNED_REPOS="arch-held omarchy arch-mact2"
# The build container: the Arch image and archive day of the official ISO's build day (archiso, grub, ...)
BUILD_IMAGE=archlinux/archlinux:base-20261018.0.612668@sha256:f9e436f35af0ca4fcd33839ae6138030342625473db4b4d1da4c6b158b37a0f9
BUILD_ARCHIVE_DATE=2026/10/18
# Node.js tarball the official ISO carries for offline mise installs
NODE_VERSION=v26.12.0
